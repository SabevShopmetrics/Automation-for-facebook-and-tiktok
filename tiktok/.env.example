# Копирайте този файл като .env и попълнете стойностите.

PREMIERE_AT=2026-11-01 10:00

# --- Google Drive: едното от двете ---
DRIVE_FOLDER_ID=
DRIVE_LOCAL_DIR=

# --- Графикът ---
SCHEDULE_CSV=data/schedule.csv
SCHEDULE_CSV_URL=

# --- Страницата-инструмент ---
# 127.0.0.1 = само от този компютър; 0.0.0.0 = от цялата офис мрежа
HOST=127.0.0.1
PORT=8765
# Адресът, който влиза в имейлите (напр. http://office-pc:8765/?k=КЛЮЧ)
TOOL_URL=http://localhost:8765/
# По желание: ключ за достъп; тогава линкът е http://.../?k=КЛЮЧ
TOOL_TOKEN=
# TikTok насрочва до 10 дни напред; клиповете се отключват 9 дни преди часа си
WINDOW_DAYS=9

# --- Имейл с напомняния и сигнали ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
