# Копирайте този файл като .env и попълнете стойностите. .env не се праща никъде.

# --- Facebook (от колежката, по документа „Facebook: ключ за страницата“) ---
FB_PAGE_ID=
FB_PAGE_TOKEN=
GRAPH_VERSION=v25.0

# Линкът към премиерата в YouTube (влиза в първия коментар)
YOUTUBE_URL=
PREMIERE_AT=2026-11-01 10:00

# --- Google Drive: едното от двете ---
# Публична папка („всеки с линка“): ID-то от адреса на папката
DRIVE_FOLDER_ID=
# ИЛИ локално синхронизирана папка (Google Drive for Desktop)
DRIVE_LOCAL_DIR=

# --- Графикът ---
SCHEDULE_CSV=data/schedule.csv
# По желание: Google Sheet, публикуван като CSV (File → Share → Publish to web → CSV)
SCHEDULE_CSV_URL=

# 1 = пробен режим, нищо не се публикува. Сменете на 0 след теста.
DRY_RUN=1

# --- Имейл при проблем (по желание) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
